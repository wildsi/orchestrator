# Copy to your shell profile or the sbatch script; never commit real values.
# Resolution order: ORCH_ORACLE_DSN, then the first line of
# ORCH_ORACLE_CREDENTIALS_FILE (chmod 600), then a hard failure.
# ORCH_ORACLE_DSN=user/password@host/service
ORCH_ORACLE_CREDENTIALS_FILE=$HOME/.orch_oracle.cred
